{
  "Email address": "[data-testid='email']",
  "Sign In": "[data-testid='sign-in']",
  "Reset": "[data-testid='reset-filter-button']",
  "Apply": "[data-testid='apply-filter-button']",
  "Back to Navigation": "//a[text()='Back to Navigation']",
  "page heading": "//h1",
  "table row": "//tbody/tr",
  "content edit heading": "//h2",
  "no results message": "//p[contains(., 'No results found')]",
  "Add New Address": "//button[contains(.,'Add New Address')]",
  "Address Type": "//label[contains(.,'Address Type')]/following::*[contains(@class,'-control')][1]",
  "Address Title": "//label[contains(.,'Title')]/following::*[contains(@class,'-control')][1]",
  "Address First Name": "input[name$='.firstName']",
  "Address Last Name": "input[name$='.lastName']",
  "Address Line 1": "input[name$='.addressLine1']",
  "Address City": "input[name$='.city']",
  "Address Postcode": "input[name$='.postcode']",
  "Address Country": "//label[contains(.,'Country')]/following::*[contains(@class,'-control')][1]",
  "Save Address": "//button[text()='Save Address']",
  "Delete Address": "//button[text()='Delete Address' and not(@data-testid)]",
  "Confirm Delete Address": "[data-testid='button-action_delete-address']",
  "address entry": "address",
  "warning toast": ".Toastify__toast--warning",
  "Content Name": "[data-testid='content-name']",
  "Open save menu": "[data-testid='content-dropdown-save']"
}
