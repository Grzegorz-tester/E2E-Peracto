{
  "header logo": "[data-testid='brand-bar__logo--desktop']",
  "category page title": "//*[@data-testid='category-page']//h2",
  "page title": "//h1",
  "Search products": "[id='searchQuery']",
  "Search products - draw": "//div[@data-testid='nav-menu']//*[@id='searchQuery']",
  "Menu": "[data-testid='navigation-bar__nav-menu-button']",
  "menu draw": "[data-testid='nav-menu']",
  "Products draw menu item": "//h2[text()='Products']",
  "Inspiration draw menu item": "//h2[text()='Inspiration']",
  "About draw menu item": "//h2[text()='About']",
  "Support draw menu item": "//h2[text()='Support']",
  "News draw menu item": "//h2[text()='News']",
  "Careers draw menu item": "//h2[text()='Careers']",
  "Products menu item": "[data-testid='navigation-bar__items-item-5']",
  "Inspiration menu item": "[data-testid='navigation-bar__items-item-9']",
  "About menu item": "[data-testid='navigation-bar__items-item-10']",
  "Support menu item": "[data-testid='navigation-bar__items-item-11']",
  "News menu item": "[data-testid='navigation-bar__items-item-12']",
  "Careers": "[data-testid='navigation-bar__items-item-95']",
  "Find a retailer menu item": "//span[text()='Find a Retailer']",
  "View brochures menu item": "//span[text()='View Brochures']",
  "Request a Sample menu item": "//span[text()='Request a Sample']",
  "magnifier glass": "[data-testid='search__form__search-button']",
  "search results": "[data-testid='search__hits']",
  "first search result": ":nth-match([data-testid='search__hits__hit'], 1)",
  "first search result image": ":nth-match([data-testid='search__hits__hit_image'], 1)",
  "second search result": ":nth-match([data-testid='search__hits__hit'], 2)",
  "No results found message": "//p[text()='No results found.']",
  "first variant": "[data-testid='product-variant-options__lozenge-0']",
  "second variant": "[data-testid='product-variant-options__lozenge-1']",
  "Portal": "[data-testid='utility-bar__content--logged-out__sign-in']",
  "contact phone number": "//a[contains(@href, 'tel')]",
  "contact email": "//a[contains(@href, 'mailto')]",
  "currency picker": "[data-testid='utility-bar__currency-selector']",
  "GBP currency option": "[data-testid='utility-bar__currency-selector--GBP']",
  "EUR currency option": "[data-testid='utility-bar__currency-selector--EUR']",
  "product price": "[data-testid='price-to-pay']",
  "basket": "//a[contains(@href, 'place-order')]",
  "Request Swatch Sample": "[data-testid='brand-bar__account-button']",
  "Find a Retailer": "[data-testid='brand-bar__branches-button']:has-text('Retailer')",
  "Request a brochures": "[data-testid='brand-bar__basket-button']",
  "Subscribe": "//button[text()='Subscribe']",
  "Sort By": "[data-testid='sort-by__dropdown']",
  "first product name": ":nth-match([data-testid='product-card'] .product-card__name, 1)",
  "product card": "[data-testid='product-card']",
  "Clear all": ":nth-match(button.ais-ClearRefinements-button, 1)",
  "A-Z": "//*[contains(@data-testid, 'sort-by__dropdown__item') and contains(text(), 'Name — A to Z')]",
  "Z-A": "//*[contains(@data-testid, 'sort-by__dropdown__item') and contains(text(), 'Name — Z to A')]",
  "Filter": "[data-testid='filters-button']",
  "SUBMIT": "//button[text()='Submit']",
  "Add to basket": "//button[text()='Add to basket']",
  "Add to basket - you may also need": "//h3[text()='You may also need']/../..//button[text()='Add to basket']",
  "Place Order": "//button[text()='Place Order']",
  "validation message": "//p[contains(@class, 'danger')]",
  "X": "//div[@id='closeButton']",
  "application error": "//h2[contains(text(), 'Application error')]",
  "page not found": "//h1[normalize-space()='Page Not Found']",
  "product gallery image": "[data-testid=\"product-media__image\"]",
  "product gallery thumbnail": "[data-testid=\"product-media__thumbnail\"]",
  "product gallery next": "[data-testid=\"product-media__carousel-next\"]",
  "product variant options": "[data-testid=\"product-variant-options\"]",
  "selected variant": "[data-testid^=\"product-variant-options__lozenge-\"].border-brand-primary",
  "specification labels": "[data-testid=\"product-specification__label\"]",
  "specification values": "[data-testid=\"product-specification__value\"]",
  "product downloads": "#downloads a[href]",
  "product video": "[data-testid=\"product-media__youtube-play\"]",
  "related products": "[data-testid=\"related-products\"]",
  "first related product": "[data-testid=\"related-products\"] a[href^=\"/products/\"] >> nth=0",
  "related articles": "[data-testid=\"related-articles\"]",
  "first related article": "[data-testid=\"related-articles\"] a[href^=\"/article/\"] >> nth=0",
  "first product card": ":nth-match([data-testid=\"product-card\"] a[href^=\"/products/\"], 1)",
  "product card name": "[data-testid=\"product-card__name\"]",
  "product card image": "[data-testid=\"product-card__media\"]",
  "breadcrumb": "[data-testid=\"breadcrumb\"]",
  "subcategory links": "[data-testid=\"content-menu-items__link\"]",
  "first subcategory link": ":nth-match([data-testid=\"content-menu-items__link\"][href^=\"/category/\"], 1)",
  "footer": "[data-testid=\"footer__desktop\"]",
  "footer social links": "[data-testid=\"footer__social__links\"] a",
  "footer Instagram link": "[data-testid=\"footer__social__links\"] a[href*=\"instagram.com\"]",
  "footer YouTube link": "[data-testid=\"footer__social__links\"] a[href*=\"youtube.com\"]",
  "footer company details": "[data-testid=\"footer__company__details\"]",
  "footer Bathroom Mirrors link": "[data-testid=\"footer__desktop\"] a[href=\"/category/bathroom-mirrors\"]",
  "footer Contact Us link": "[data-testid=\"footer__desktop\"] a[href=\"/contact-us\"]",
  "footer Sitemap link": "[data-testid=\"footer__company\"] a[href=\"/sitemap\"]",
  "Stay Inspired Subscribe": "#subscribe-block a:has-text(\"Subscribe\")",
  "newsletter signup iframe": "iframe[src*=\"mailerlite.com\"]",
  "newsletter signup email": "input[name=\"fields.email\"]"
}
