  "footer Twitter icon": "[data-testid=\"main-footer__social-link-twitter\"]",
  "footer Pinterest icon": "[data-testid=\"main-footer__social-link-pinterest\"]",
  "footer TikTok icon": "[data-testid=\"main-footer__social-link-tiktok\"]",
  "newsletter form": "[data-testid=\"newsletter-form\"]",
  "newsletter privacy policy link": "[data-testid=\"newsletter-form__privacy-policy-link\"]",
