{
  "Accept cookies": "#onetrust-accept-btn-handler",
  "cookie preference centre overlay": ".onetrust-pc-dark-filter",
  "close cookie preference centre": "#close-pc-btn-handler",
  "Search products": "input[name='query']:visible",
  "category navigation": ".mega-menu-categories-desktop",
  "first search result": ":nth-match(a.view-product-btn, 1)",
  "search result card": ".card-fresh",
  "search result card title": ".card-fresh__title",
  "Add to basket": ".pdp-atb-btn",
  "basket header link": "#nav-basket",
  "View basket": ".brand-btn-checkout",

  "Ex VAT toggle": "a.js-vat-link",
  "Ex VAT label": ".utility-bar__vat-toggle .mobile-tax-span--exc",
  "Inc VAT label": ".utility-bar__vat-toggle .mobile-tax-span--inc",

  "sign-in prompt continue as guest button": ":text-is('Continue as guest'):visible",

  "new quote name input": "input[placeholder='Enter new quote name']:visible",
  "Create new quote button": "button:has-text('Create new quote'):visible",

  "address first name": "#address_firstname",
  "address last name": "#address_lastname",
  "address telephone": "#address_telephone",
  "address line 1": "#address_address_line_1",
  "address line 2": "#address_address_line_2",
  "address city": "#address_city",
  "address postcode": "#address_postcode",
  "address country": "#address_country",
  "Save address": "form:has(#address_firstname) button[type='submit']"
}
