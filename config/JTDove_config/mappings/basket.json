{
  "basket title": "[data-testid='default-basket-content__title']",
  "Continue shopping": "[data-testid='default-basket-content__continue-shopping-link']",
  "no items message": "//main//*[normalize-space()='You have no items in your basket.']",
  "Quick Buy": "[data-testid='basket-quick-buy']",
  "basket lines": "[data-testid^='basket-items__available-line-'][data-testid$='__name']",
  "basket line name": "[data-testid='basket-items__available-line-0__name']",
  "basket line sku": "[data-testid='basket-items__available-line-0__sku']",
  "basket line price": "[data-testid='basket-items__available-line-0__price-price']",
  "basket line total price": "[data-testid^='basket-items__available-line-'][data-testid$='__total-price']:visible",
  "remove basket line": "[data-testid^='basket-items__available-line-'][data-testid$='__remove-button']:visible",
  "Remove item": "[data-testid='basket-items__available-line-0__remove-button']",
  "basket quantity input": "[data-testid='basket-items__available-line-0__price-quantity-picker'] [data-testid='quantity-picker__input']",
  "quantity input": "[data-testid='basket-items__available-line-0__price-quantity-picker'] [data-testid='quantity-picker__input']",
  "basket quantity increment": "[data-testid='basket-items__available-line-0__price-quantity-picker'] [data-testid='quantity-picker__plus-button']",
  "basket quantity decrement": "[data-testid='basket-items__available-line-0__price-quantity-picker'] [data-testid='quantity-picker__minus-button']",
  "Collect at branch toggle": "[data-testid='basket-items'] button:has-text('Collect at branch')",
  "Deliver toggle": "[data-testid='basket-items'] button:has-text('Deliver')",
  "collect at branch heading": "//*[@data-testid='basket-items']//*[starts-with(normalize-space(), 'Collect at Branch')]",
  "Change Branch": "[data-testid='basket-items'] button:has-text('Change Branch')",
  "basket sub total": "[data-testid='basket-summary__subtotal']",
  "basket total": "[data-testid='basket-summary__total']",
  "order total price": "[data-testid='basket-summary__total']",
  "Add a promotional code?": "[data-testid='basket-summary'] [data-testid='add-promotion-form__button']",
  "Promo code input": "[data-testid='basket-summary'] [data-testid='add-promotion-form__input']",
  "Apply promo code": "[data-testid='basket-summary'] [data-testid='add-promotion-form__button']",
  "promo code error": "//*[@data-testid='basket-summary']//*[contains(@class, 'danger') or contains(@class, 'error') or @role='alert' or contains(., 'not a valid')][normalize-space()][not(self::form)]",
  "Go to checkout": "[data-testid='basket-summary'] button:has-text('Go to checkout'):visible",
  "basket privacy policy link": "[data-testid='basket-summary__privacy-policy-link']"
}
