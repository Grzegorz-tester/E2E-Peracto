{
  "account menu": "[data-testid='account-menu']",
  "account welcome": "[data-testid='account-menu__welcome']",
  "Sign Out": "[data-testid='account-menu__logout']",
  "Dashboard menu item": "[data-testid='account-menu__item']:has-text('Dashboard')",
  "Profile menu item": "[data-testid='account-menu__item']:has-text('Profile')",
  "Address Book menu item": "[data-testid='account-menu__item']:has-text('Address Book')",
  "Invoices menu item": "[data-testid='account-menu__item']:has-text('Invoices')",
  "My Lists menu item": "[data-testid='account-menu__item']:has-text('My Lists')",
  "Make a Payment menu item": "[data-testid='account-menu__item']:has-text('Make a Payment')",
  "wishlists title": "[data-testid='account-wishlists__title']",
  "Create a new Wishlist": "main :text('Create a new Wishlist')",
  "new wishlist name input": "[role='dialog'] input:visible",
  "Create wishlist submit": "[role='dialog'] button:has-text('Create Wishlist')",
  "Wishlist search input": "[data-testid='account-wishlists-name-filter']",
  "search bar": "[data-testid='account-wishlists-name-filter']",
  "Wishlist rows": "tr[data-testid^='account-wishlists-row-']",
  "Delete Row": "[data-testid$='-cell-delete'] button, [data-testid$='-cell-delete'] a",
  "Confirm deletion proceed": "[role='alertdialog'] button:has-text('Delete'), [role='dialog'] button:has-text('Delete'), [role='alertdialog'] button:has-text('Confirm'), [role='dialog'] button:has-text('Confirm')",
  "Reset filters": "[data-testid='account-wishlists-filter-reset']",
  "first wishlist edit link": "[data-testid='account-wishlists-row-0-cell-edit'] a",
  "Wishlist names": "[data-testid^='account-wishlists-row-'][data-testid$='-cell-name']",
  "wishlist created toast": "text=Your wishlist was created!",
  "Close wishlist dialog": "[role='dialog'] button:has(svg[data-icon='xmark']), [role='dialog'] button:has-text('Close')"
}
