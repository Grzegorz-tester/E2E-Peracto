{
  "home": {
    "route": "/",
    "regex": "^/$"
  },
  "register": {
    "route": "/rejestracja",
    "regex": "^/rejestracja$"
  },
  "register-confirmed": {
    "route": "/potwierdzenie-rejestracji",
    "regex": "^/potwierdzenie-rejestracji$"
  },
  "basket": {
    "route": "/koszyk",
    "regex": "^/koszyk$"
  },
  "checkout": {
    "route": "/realizacja-transakcji",
    "regex": "^/realizacja-transakcji$"
  },
  "checkout-delivery": {
    "route": "/realizacja-transakcji/delivery",
    "regex": "^/realizacja-transakcji/delivery$"
  },
  "search": {
    "route": "/search",
    "regex": "^/search$"
  },
  "pdp": {
    "route": "/produkt/",
    "regex": "^/produkt/[^/]+$"
  },
  "added-to-basket": {
    "route": "/dodano-do-koszyka",
    "regex": "^/dodano-do-koszyka$"
  },
  "checkout-payment": {
    "route": "/realizacja-transakcji/payment",
    "regex": "^/realizacja\\-transakcji/payment$"
  },
  "login": {
    "route": "/logowanie",
    "regex": "^/logowanie$"
  },
  "account": {
    "route": "/konto",
    "regex": "^/konto$"
  },
  "account-profile": {
    "route": "/konto/profil-klienta",
    "regex": "^/konto/profil\\-klienta$"
  },
  "checkout-thanks": {
    "route": "/realizacja-transakcji/dziekujemy",
    "regex": "^/realizacja\\-transakcji/dziekujemy$"
  },
  "plp": {
    "route": "/posadzki",
    "regex": "^/(posadzki|sciany|dachy|specjalistyczne-zastosowanie|farby|naprawy|antyposlizgowosc-i-bezpieczenstwo|ogolna-konserwacja)(/[a-z0-9-]+)*$"
  },
  "forgotten": {
    "route": "/pomin",
    "regex": "^/pomin$"
  },
  "check-email": {
    "route": "/e-mail-sprawdz",
    "regex": "^/e-mail-sprawdz$"
  },
  "change-password": {
    "route": "/konto/zmiana-hasła",
    "regex": "^/konto/zmiana-has%C5%82a$"
  },
  "address-book-list": {
    "route": "/konto/ksiazka-adresowa/lista",
    "regex": "^/konto/ksiazka-adresowa/lista$"
  },
  "address-book-new": {
    "route": "/konto/ksiazka-adresowa/nowy",
    "regex": "^/konto/ksiazka-adresowa/nowy$"
  },
  "address-book-edit": {
    "route": "/konto/ksiazka-adresowa/edytuj",
    "regex": "^/konto/ksiazka-adresowa/edytuj/[0-9]+$"
  },
  "order-list": {
    "route": "/konto/zamowienie/lista",
    "regex": "^/konto/zamowienie/lista$"
  },
  "order-detail": {
    "route": "/konto/zamowienie/szczegoly",
    "regex": "^/konto/zamowienie/szczegoly/[0-9]+$"
  }
}
