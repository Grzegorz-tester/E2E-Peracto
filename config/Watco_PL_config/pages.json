{
  "home": {
    "route": "/",
    "regex": "^/$"
  },
  "register": {
    "route": "/rejestracja",
    "regex": "^/rejestracja$"
  },
  "register-confirmed": {
    "route": "/potwierdzenie-rejestracji",
    "regex": "^/potwierdzenie-rejestracji$"
  },
  "basket": {
    "route": "/koszyk",
    "regex": "^/koszyk$"
  },
  "checkout": {
    "route": "/realizacja-transakcji",
    "regex": "^/realizacja-transakcji$"
  },
  "checkout-delivery": {
    "route": "/realizacja-transakcji/delivery",
    "regex": "^/realizacja-transakcji/delivery$"
  },
  "search": {
    "route": "/search",
    "regex": "^/search$"
  },
  "pdp": {
    "route": "/produkt/",
    "regex": "^/produkt/[^/]+$"
  },
  "added-to-basket": {
    "route": "/added-to-basket",
    "regex": "^/added-to-basket$"
  },
  "checkout-payment": {
    "route": "/realizacja-transakcji/payment",
    "regex": "^/realizacja\\-transakcji/payment$"
  },
  "login": {
    "route": "/logowanie",
    "regex": "^/logowanie$"
  },
  "account": {
    "route": "/konto",
    "regex": "^/konto$"
  },
  "account-profile": {
    "route": "/konto/profil-klienta",
    "regex": "^/konto/profil\\-klienta$"
  },
  "checkout-thanks": {
    "route": "/realizacja-transakcji/dziekujemy",
    "regex": "^/realizacja\\-transakcji/dziekujemy$"
  }
}
