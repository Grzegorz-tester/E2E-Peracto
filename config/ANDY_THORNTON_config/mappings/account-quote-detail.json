{
  "quote title": "[data-testid='quote-builder__header'] h1, [data-testid='quote-builder__header'] h2",
  "quote details": "[data-testid='quote-builder__details']",
  "Edit quote icon": "[data-testid='quote-builder__edit-quote']",
  "Moodboard view icon": "[data-testid='quote-builder__moodboard']",
  "Delete quote icon": "[data-testid='quote-builder__header'] button:has(svg.fa-trash-can)",
  "Generate Quote": "[data-testid='quote-builder'] button:has-text('Generate Quote')",
  "Open in New Tab": ":text-is('Open in New Tab')",
  "Download quote PDF": ":text-is('Download')",
  "Show VAT toggle": ":nth-match([data-testid='quote-builder'] [data-testid='switch__checkbox'], 1)",
  "Show VAT in Total": "[data-testid='quote-builder'] button:has-text('Show VAT in Total')",
  "new section name": "main input[placeholder='Name']",
  "Add section": "//main//button[normalize-space()='Add']",
  "quote section": "[data-testid='quote-builder__group']",
  "Include in Quote": "[data-testid='quote-builder__group'] button:has-text('Include in Quote')",
  "catalogue search": "[data-testid='quote-builder__group'] [data-testid='algolia-autocomplete__input']",
  "catalogue first result": "[data-testid='simple-search__algolia-autocomplete-hit-product']",
  "catalogue results": "[data-testid='algolia-autocomplete-hits']",
  "Add Custom Item": "[data-testid='quote-builder__group'] button[role='combobox']",
  "quote item name": "[data-testid='quote-builder__group'] input[name$='.itemName']",
  "quote item sku": "[data-testid='quote-builder__group'] input[name$='.sku']",
  "quote item price": ":nth-match([data-testid='quote-builder__group'] [data-testid='quantity-picker__input'], 1)",
  "quote item quantity": ":nth-match([data-testid='quote-builder__group'] [data-testid='quantity-picker__input'], 2)",
  "unsaved changes bar": "//*[normalize-space()='You have unsaved changes']",
  "Save Changes": "button:has-text('Save Changes')",
  "Reset Changes": "button:has-text('Reset Changes')",
  "toast": ".Toastify__toast"
}
