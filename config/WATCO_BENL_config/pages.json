{
  "home": {
    "route": "/",
    "regex": "^/$"
  },
  "register": {
    "route": "/registreren",
    "regex": "^/registreren$"
  },
  "register-confirmed": {
    "route": "/registratie-geldig",
    "regex": "^/registratie-geldig$"
  },
  "basket": {
    "route": "/winkelmandje",
    "regex": "^/winkelmandje$"
  },
  "checkout": {
    "route": "/de-bestelling-valideren",
    "regex": "^/de-bestelling-valideren$"
  },
  "checkout-delivery": {
    "route": "/de-bestelling-valideren/delivery",
    "regex": "^/de-bestelling-valideren/delivery$"
  },
  "search": {
    "route": "/search",
    "regex": "^/search$"
  },
  "pdp": {
    "route": "/producten/",
    "regex": "^/producten/[^/]+$"
  },
  "added-to-basket": {
    "route": "/added-to-basket",
    "regex": "^/added-to-basket$"
  },
  "checkout-payment": {
    "route": "/de-bestelling-valideren/payment",
    "regex": "^/de\\-bestelling\\-valideren/payment$"
  },
  "login": {
    "route": "/inloggen",
    "regex": "^/inloggen$"
  },
  "account": {
    "route": "/mijn-account",
    "regex": "^/mijn\\-account$"
  },
  "account-profile": {
    "route": "/mijn-account/persoonlijke-informatie",
    "regex": "^/mijn\\-account/persoonlijke\\-informatie$"
  },
  "checkout-thanks": {
    "route": "/bestelling-bevestigen/bedankt",
    "regex": "^/bestelling\\-bevestigen/bedankt$"
  },
  "plp": {
    "route": "/vloeren",
    "regex": "^/(vloeren|muren|daken|metaalbescherming|verven|reparatie|antislip-veiligheid|onderhoud-bescherming)(/[a-z0-9-]+)*$"
  },
  "forgotten": {
    "route": "/vergeten",
    "regex": "^/vergeten$"
  },
  "check-email": {
    "route": "/bevestiging-opnieuw-instellen",
    "regex": "^/bevestiging-opnieuw-instellen$"
  },
  "change-password": {
    "route": "/mijn-account/wachtwoord-wijzigen",
    "regex": "^/mijn-account/wachtwoord-wijzigen$"
  },
  "address-book-list": {
    "route": "/mijn-account/mijn-adressen/weergeven",
    "regex": "^/mijn-account/mijn-adressen/weergeven$"
  },
  "address-book-new": {
    "route": "/mijn-account/mijn-adressen/adres-toevoegen",
    "regex": "^/mijn-account/mijn-adressen/adres-toevoegen$"
  },
  "address-book-edit": {
    "route": "/mijn-account/mijn-adressen/wijzigen",
    "regex": "^/mijn-account/mijn-adressen/wijzigen/[0-9]+$"
  },
  "order-list": {
    "route": "/mijn-account/bestellen/lijst",
    "regex": "^/mijn-account/bestellen/lijst$"
  },
  "order-detail": {
    "route": "/mijn-account/bestellen/details",
    "regex": "^/mijn-account/bestellen/details/[0-9]+$"
  }
}
