{
  "page heading": "h1 >> visible=true",
  "header logo": "[data-testid='brand-bar__logo--desktop']",
  "header search input": "[data-testid='algolia-autocomplete__input']",
  "search suggestions": "[data-testid='algolia-autocomplete-hits']",
  "search suggestion names": "[data-testid='algolia-autocomplete-hit-product__name']",
  "first search suggestion": "(//*[@data-testid='algolia-autocomplete-hit-product'])[1]",
  "Find a branch": "[data-testid='brand-bar__branches-link']",
  "Book a design consultation": "[data-testid='brand-bar'] a[href='/book-a-consultation']",
  "footer sitemap link": "[data-testid='stripped-footer__sitemap-link']",
  "hit count": "[data-testid='algolia-hit-count'] >> visible=true",
  "product cards": "[data-testid='algolia-hits__hits'] [data-testid='product-card']",
  "product card names": "[data-testid='algolia-hits__hits'] [data-testid='product-card__name']",
  "product card images": "[data-testid='algolia-hits__hits'] [data-testid='product-card__image']",
  "first product card": "(//*[@data-testid='algolia-hits__hits']//*[@data-testid='product-card__link'])[1]",
  "first product card name": "(//*[@data-testid='algolia-hits__hits']//*[@data-testid='product-card__name'])[1]",
  "first product card image": "(//*[@data-testid='algolia-hits__hits']//*[@data-testid='product-card__image'])[1]",
  "Filter button": "[data-testid='algolia-facet-drawer__open-button']",
  "filter drawer": "[data-testid='algolia-facet-drawer__title'] >> visible=true",
  "first filter checkbox": "[role='dialog'] [data-testid='algolia-refinement-list__checkbox-0'] >> nth=0",
  "Close filter drawer": "[role='dialog'] button:has-text('Close')",
  "applied filters": "[data-testid='algolia-current-refinements-horizontal'] >> visible=true",
  "Clear all filters": "[data-testid='algolia-clear-refinements'] >> visible=true",
  "pagination": "[data-testid='algolia-pagination']",
  "pagination page 1": "[data-testid='algolia-pagination__page-0']",
  "pagination page 2": "[data-testid='algolia-pagination__page-1']",
  "pagination next": "[data-testid='algolia-pagination__next-button']"
}
