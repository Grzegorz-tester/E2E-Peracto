{
  "account menu": "[data-testid='account-menu']",
  "account welcome": "[data-testid='account-menu__welcome']",
  "Sign Out": "[data-testid='account-menu__logout']",
  "Dashboard menu item": "[data-testid='account-menu__item']:has-text('Dashboard')",
  "Profile menu item": "[data-testid='account-menu__item']:has-text('Profile')",
  "Address Book menu item": "[data-testid='account-menu__item']:has-text('Address Book')",
  "Invoices menu item": "[data-testid='account-menu__item']:has-text('Invoices')",
  "My Lists menu item": "[data-testid='account-menu__item']:has-text('My Lists')",
  "Make a Payment menu item": "[data-testid='account-menu__item']:has-text('Make a Payment')",
  "Wishlist title": "(//main//h1 | //main//h2)[last()]",
  "Wishlist product cards": "main [data-testid*='product-card']:visible, main [data-testid*='wishlist-item']:visible",
  "Wishlist lines": "[data-testid='wishlist-builder__lines']",
  "ADD WISHLIST TO BASKET": "main button:has-text('Add wishlist to basket')",
  "breadcrumb": "[data-testid='breadcrumb']",
  "Share": "main button:has-text('Share')",
  "Edit Name": "main button:has-text('Edit Name')",
  "Delete Wishlist": "main button:has-text('Delete Wishlist')",
  "share dialog": "[role='dialog']:has-text('Share Wishlist')",
  "share email input": "[role='dialog'] [data-testid='input']",
  "Share submit": "[role='dialog'] button:has-text('Share')",
  "share dialog close": "[role='dialog']:has-text('Share Wishlist') > button:has-text('Close')",
  "edit name dialog": "[role='dialog']:has-text('Edit Wishlist')",
  "edit name input": "[role='dialog'] input[id='Wishlist Name']",
  "Save name": "[role='dialog'] button:has-text('Save Changes')",
  "delete wishlist dialog": "[role='dialog']:has-text('Are you sure you want to delete this wishlist')",
  "Confirm delete wishlist": "[role='dialog'] button:has-text('Delete Wishlist')",
  "quick add": "[data-testid='basket-quick-buy']",
  "quick add input": "[data-testid='basket-quick-buy'] [data-testid='algolia-autocomplete__input']",
  "first quick add result": "[data-testid='algolia-autocomplete-hit-product']:visible >> nth=0",
  "wishlist total panel": "//h3[normalize-space()='Wishlist Total']/..",
  "first line quantity": "[data-testid='wishlist-builder__lines'] [data-testid='quantity-picker__input'] >> nth=0",
  "first line increment": "[data-testid='wishlist-builder__lines'] [data-testid='quantity-picker__plus-button'] >> nth=0",
  "first line Update": "[data-testid='wishlist-builder__lines'] button:has-text('Update') >> nth=0",
  "first line Remove": "[data-testid='wishlist-builder__lines'] button:has-text('Remove') >> nth=0",
  "first line total": "(//*[@data-testid='wishlist-builder__lines']//span[normalize-space()='Total']/following-sibling::span[1])[1]",
  "wishlist line rows": "[data-testid='wishlist-builder__lines'] > [data-id^='lines.']",
  "first line name": "(//*[@data-testid='wishlist-builder__lines']//a//span[1])[1]",
  "empty wishlist message": "//main//*[normalize-space()='There are currently no products in this wishlist.']"
}
