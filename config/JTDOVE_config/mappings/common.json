  "added to basket product name": "[data-testid='product-added-to-basket__product-name']",
  "added to basket quantity": "[data-testid='product-added-to-basket__product-quantity']",
  "added to basket total": "[data-testid='product-added-to-basket__basket-totals-total']",
  "View basket": "[data-testid='product-added-to-basket__view-basket']",
