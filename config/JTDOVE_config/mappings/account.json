  "Delivery Address default label": "[data-testid='account-card']:has([data-testid='account-card__title']:text-is('Delivery Address')) [data-testid='address-book-address__is-default-address']",
  "Billing Address default label": "[data-testid='account-card']:has([data-testid='account-card__title']:text-is('Billing Address')) [data-testid='address-book-address__is-default-address']",
  "Delivery Address View all": "[data-testid='account-card']:has([data-testid='account-card__title']:text-is('Delivery Address')) a:has-text('View all')",
