# Copy to `.env` (gitignored) and fill in real values.
# These override the blank credentials in config/*/users.json at runtime,
# so real login secrets never get committed to source control.
#
# Naming: <USER TYPE, upper-cased, spaces -> underscores>_EMAIL / _PASSWORD
# e.g. the "logged in" user type reads LOGGED_IN_EMAIL / LOGGED_IN_PASSWORD
#
# Optional per-project override: prefix with PROJECT (set in the active
# block of env/*.env), upper-cased, e.g. PROJECT=insinkerator_eu reads
# INSINKERATOR_EU_LOGGED_IN_EMAIL first, falling back to LOGGED_IN_EMAIL.
# Each storefront's real test account is a distinct address (often a
# plus-aliased one, e.g. name+projectname_automation@domain), not one
# identity shared across every client, so prefer the per-project vars
# whenever a project's real account differs from the generic one.

ADMIN_EMAIL=
ADMIN_PASSWORD=
LOGGED_IN_EMAIL=
LOGGED_IN_PASSWORD=

# INSINKERATOR_EU_LOGGED_IN_EMAIL=
# INSINKERATOR_EU_LOGGED_IN_PASSWORD=

# RUSSELLS_LOGGED_IN_EMAIL=
# RUSSELLS_LOGGED_IN_PASSWORD=
# Storefront wishlists are gated to an admin account (see
# account-wishlists.feature) - a distinct account from RUSSELLS_LOGGED_IN,
# not the separate RUSSELLS_ADMIN_ADMIN pair (that one logs into the
# Peracto Admin *site*, a different project entirely).
# RUSSELLS_WISHLIST_ADMIN_EMAIL=
# RUSSELLS_WISHLIST_ADMIN_PASSWORD=

# KEYLITE_LOGGED_IN_EMAIL=
# KEYLITE_LOGGED_IN_PASSWORD=
# Storefront account (staging.keyliteroofwindows.pub). The admin site
# (staging-peracto.keyliteroofwindows.pub, PROJECT=keylite_admin) reuses the
# same real account via the generic ADMIN_EMAIL/ADMIN_PASSWORD fallback
# above - confirmed live 2026-09-06 the one account works on both sites -
# so no separate KEYLITE_ADMIN_ADMIN_* pair is needed unless that changes.

# ANDY_THORNTON_LOGGED_IN_EMAIL=
# ANDY_THORNTON_LOGGED_IN_PASSWORD=
# The generic LOGGED_IN_EMAIL/PASSWORD account is NOT registered on
# staging.andythornton.pub (confirmed live 2026-09-05: "Invalid credentials."),
# and registration can't be scripted around this gap - the /register form is
# behind reCAPTCHA, which fails in headless automation. A real account needs
# registering by hand (staging, so this is safe) before any "logged in" user
# scenario in Andy_Thornton_features can run; see
# src/features/Andy_Thornton_features/my-account.feature and header.feature.
