# Copy to `.env` (gitignored) and fill in real values.
# These override the blank credentials in config/*/users.json at runtime,
# so real login secrets never get committed to source control.
#
# Naming: <USER TYPE, upper-cased, spaces -> underscores>_EMAIL / _PASSWORD
# e.g. the "logged in" user type reads LOGGED_IN_EMAIL / LOGGED_IN_PASSWORD
#
# Optional per-project override: prefix with PROJECT (set in the active
# block of env/*.env), upper-cased, e.g. PROJECT=insinkerator_eu reads
# INSINKERATOR_EU_LOGGED_IN_EMAIL first, falling back to LOGGED_IN_EMAIL.
# Each storefront's real test account is a distinct address (often a
# plus-aliased one, e.g. name+projectname_automation@domain), not one
# identity shared across every client, so prefer the per-project vars
# whenever a project's real account differs from the generic one.

ADMIN_EMAIL=
ADMIN_PASSWORD=
LOGGED_IN_EMAIL=
LOGGED_IN_PASSWORD=

# INSINKERATOR_EU_LOGGED_IN_EMAIL=
# INSINKERATOR_EU_LOGGED_IN_PASSWORD=
