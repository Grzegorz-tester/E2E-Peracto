UI_AUTOMATION_BROWSER='chromium'
UI_AUTOMATION_HOST=production
SCREENSHOT_PATH=./reports/screenshots/
VIDEO_PATH=./reports/videos/
JSON_REPORT_FILE=./reports/report.json
HTML_REPORT_FILE=./reports/cucumber-html-report.html
HEADLESS=true
SCRIPT_TIMEOUT=20000
PARALLEL=1
RETRY=1
HOSTS_URL_PATH=/config/PizzaExpressLive_config/hosts.json
PAGES_URL_PATH=/config/PizzaExpressLive_config/pages.json
PAGE_ELEMENTS_PATH=/config/PizzaExpressLive_config/mappings/
USERS_CONFIG_PATH=/config/PizzaExpressLive_config/users.json
PROJECT=pizzaexpresslive

# There is no native login page - "logged in" account access (My Account,
# Basket) is entirely inside the third-party Spektrix iframe embedded on
# /account and /basket, not a PizzaExpressLive-hosted form. The framework's
# shared login step assumes a native `<host>/login` page, so it isn't wired
# up for this project yet - see the Spektrix Booking Integration feature
# for why (Cloudflare bot-protection blocks headless automation inside that
# iframe, confirmed live 2026-08-20). LOGIN_URL/LOGIN_SUCCESS_URL are set to
# sensible values regardless, for whenever that's revisited.
LOGIN_URL=https://www.pizzaexpresslive.com/account
GUEST_URL=https://www.pizzaexpresslive.com
LOGIN_SUCCESS_URL=https://www.pizzaexpresslive.com/account

FEATURE_PATH=./src/features/PizzaExpressLive_features/**/*.feature
