UI_AUTOMATION_BROWSER='chromium'
UI_AUTOMATION_HOST=staging
SCREENSHOT_PATH=./reports/screenshots/
VIDEO_PATH=./reports/videos/
JSON_REPORT_FILE=./reports/report.json
HTML_REPORT_FILE=./reports/cucumber-html-report.html
HEADLESS=true
SCRIPT_TIMEOUT=20000
PARALLEL=1
RETRY=1
PROJECT=keylite_admin
HOSTS_URL_PATH=/config/Keylite_ADMIN_config/hosts.json
PAGES_URL_PATH=/config/Keylite_ADMIN_config/pages.json
PAGE_ELEMENTS_PATH=/config/Keylite_ADMIN_config/mappings/
USERS_CONFIG_PATH=/config/Keylite_ADMIN_config/users.json
LOGIN_URL=https://staging-peracto.keyliteroofwindows.pub/login
GUEST_URL=https://staging-peracto.keyliteroofwindows.pub
LOGIN_SUCCESS_URL=https://staging-peracto.keyliteroofwindows.pub/

FEATURE_PATH=./src/features/Carbon_admin/**/*.feature ./src/features/Keylite_ADMIN_features/**/*.feature
