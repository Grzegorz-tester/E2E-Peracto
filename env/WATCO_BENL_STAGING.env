UI_AUTOMATION_BROWSER='chromium'
UI_AUTOMATION_HOST=staging
SCREENSHOT_PATH=./reports/screenshots/
VIDEO_PATH=./reports/videos/
JSON_REPORT_FILE=./reports/WATCO_BENL_STAGING/report.json
HTML_REPORT_FILE=./reports/cucumber-html-report.html
HEADLESS=true
SCRIPT_TIMEOUT=20000
PARALLEL=1
RETRY=1
PROJECT=watco_benl
HOSTS_URL_PATH=/config/WATCO_BENL_config/hosts.json
PAGES_URL_PATH=/config/WATCO_BENL_config/pages.json
PAGE_ELEMENTS_PATH=/config/WATCO_BENL_config/mappings/
USERS_CONFIG_PATH=/config/WATCO_BENL_config/users.json
GUEST_URL=https://staging-benl.watco.pub

FEATURE_PATH=./src/features/WATCO_BENL_features/**/*.feature ./src/features/WATCO_SHARED_features/**/*.feature
