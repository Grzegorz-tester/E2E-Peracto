PAGES_URL_PATH=/config/ANDY_THORNTON_ADMIN_config/pages.json
PAGE_ELEMENTS_PATH=/config/ANDY_THORNTON_ADMIN_config/mappings/
USERS_CONFIG_PATH=/config/ANDY_THORNTON_ADMIN_config/users.json
LOGIN_URL=https://peracto.andythornton.com/login
GUEST_URL=https://peracto.andythornton.com
