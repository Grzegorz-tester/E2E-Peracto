UI_AUTOMATION_BROWSER='chromium'
UI_AUTOMATION_HOST=release_branch
SCREENSHOT_PATH=./reports/screenshots/
VIDEO_PATH=./reports/videos/
JSON_REPORT_FILE=./reports/JTDOVE_RELEASE/report.json
HTML_REPORT_FILE=./reports/cucumber-html-report.html
HEADLESS=true
SCRIPT_TIMEOUT=25000
PARALLEL=1
RETRY=1
HOSTS_URL_PATH=/config/JTDOVE_config/hosts.json
PAGES_URL_PATH=/config/JTDOVE_config/pages.json
PAGE_ELEMENTS_PATH=/config/JTDOVE_config/mappings/
USERS_CONFIG_PATH=/config/JTDOVE_config/users.json
LOGIN_URL=https://4-4-0.jtdove.pub/login
GUEST_URL=https://4-4-0.jtdove.pub
LOGIN_SUCCESS_URL=https://4-4-0.jtdove.pub/account
PROJECT=jtdove
BLOCK_REQUEST_HOSTS=cookiebot.com cookiebot.eu

FEATURE_PATH=./src/features/JTDOVE_features/**/*.feature

# Admin API (orders reaching admin, throwaway product fixtures) and the
# public, search-only Algolia key the storefront ships to every browser.
# Since 2026-11-23 the 4-4-0 release has its own API (4-4-0-api.jtdove.pub,
# same admin login) but still searches the staging Algolia index.
API_BASE_URL=https://4-4-0-api.jtdove.pub
ALGOLIA_APP_ID=WB46JP6INM
ALGOLIA_SEARCH_KEY=69784fbf45e6d8833b10c65613dd0257
ALGOLIA_INDEX=staging_jtd
