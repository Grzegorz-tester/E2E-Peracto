UI_AUTOMATION_BROWSER='chromium'
UI_AUTOMATION_HOST=release_branch
SCREENSHOT_PATH=./reports/screenshots/
VIDEO_PATH=./reports/videos/
JSON_REPORT_FILE=./reports/Lamona_ADMIN_RELEASE/report.json
HTML_REPORT_FILE=./reports/cucumber-html-report.html
HEADLESS=true
SCRIPT_TIMEOUT=20000
PARALLEL=1
RETRY=1
PROJECT=lamona_admin
EXCLUDE_TAGS=@user-groups @product-variants @requires-product-export
HOSTS_URL_PATH=/config/Lamona_ADMIN_config/hosts.json
PAGES_URL_PATH=/config/Lamona_ADMIN_config/pages.json
PAGE_ELEMENTS_PATH=/config/Lamona_ADMIN_config/mappings/
USERS_CONFIG_PATH=/config/Lamona_ADMIN_config/users.json
LOGIN_URL=https://2-8-0-peracto.lamonasparescouk.pub/login
GUEST_URL=https://2-8-0-peracto.lamonasparescouk.pub
LOGIN_SUCCESS_URL=https://2-8-0-peracto.lamonasparescouk.pub/

FEATURE_PATH=./src/features/Carbon_admin/**/*.feature
