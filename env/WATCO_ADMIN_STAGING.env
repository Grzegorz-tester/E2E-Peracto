# Watco UK admin (legacy server-rendered Peracto v6.1 at <storefront host>/peracto,
# NOT the React Peracto Admin, so it does not use CARBON_ADMIN_SHARED_features).
# Suite is READ-ONLY by design (user, 2026-10-24): it never creates, edits or
# deletes anything, so it is also safe in shape for production.
UI_AUTOMATION_BROWSER='chromium'
UI_AUTOMATION_HOST=staging
SCREENSHOT_PATH=./reports/screenshots/
VIDEO_PATH=./reports/videos/
JSON_REPORT_FILE=./reports/WATCO_ADMIN_STAGING/report.json
HTML_REPORT_FILE=./reports/cucumber-html-report.html
HEADLESS=true
SCRIPT_TIMEOUT=60000
PARALLEL=1
RETRY=1
PROJECT=watco_admin
HOSTS_URL_PATH=/config/WATCO_ADMIN_config/hosts.json
PAGES_URL_PATH=/config/WATCO_ADMIN_config/pages.json
PAGE_ELEMENTS_PATH=/config/WATCO_ADMIN_config/mappings/
USERS_CONFIG_PATH=/config/WATCO_ADMIN_config/users.json
LOGIN_URL=https://staging-uk.watco.pub/peracto/login
GUEST_URL=https://staging-uk.watco.pub/peracto
LOGIN_SUCCESS_URL=https://staging-uk.watco.pub/peracto

FEATURE_PATH=./src/features/WATCO_ADMIN_features/**/*.feature
