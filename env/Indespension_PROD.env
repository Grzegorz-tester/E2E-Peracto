UI_AUTOMATION_BROWSER='chromium'
UI_AUTOMATION_HOST=production
SCREENSHOT_PATH=./reports/screenshots/
VIDEO_PATH=./reports/videos/
JSON_REPORT_FILE=./reports/Indespension_PROD/report.json
HTML_REPORT_FILE=./reports/cucumber-html-report.html
HEADLESS=true
SCRIPT_TIMEOUT=20000
PARALLEL=1
RETRY=1
PROJECT=indespension_prod
HOSTS_URL_PATH=/config/Indespension_config/hosts.json
PAGES_URL_PATH=/config/Indespension_config/pages.json
PAGE_ELEMENTS_PATH=/config/Indespension_config/mappings/
USERS_CONFIG_PATH=/config/Indespension_config/users.json
LOGIN_URL=https://indespension.co.uk/login
GUEST_URL=https://indespension.co.uk
LOGIN_SUCCESS_URL=https://indespension.co.uk/account

BLOCK_REQUEST_HOSTS=cookiebot.com cookiebot.eu

FEATURE_PATH=./src/features/Indespension_features/**/*.feature
