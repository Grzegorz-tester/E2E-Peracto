UI_AUTOMATION_BROWSER='chromium'
UI_AUTOMATION_HOST=production
SCREENSHOT_PATH=./reports/screenshots/
VIDEO_PATH=./reports/videos/
JSON_REPORT_FILE=./reports/HIB_ADMIN_PROD/report.json
HTML_REPORT_FILE=./reports/cucumber-html-report.html
HEADLESS=true
SCRIPT_TIMEOUT=35000
PARALLEL=1
RETRY=1
PROJECT=hib_admin_prod
EXCLUDE_TAGS=@requires-shipping-services @requires-active-promotions
HOSTS_URL_PATH=/config/HIB_ADMIN_config/hosts.json
PAGES_URL_PATH=/config/HIB_ADMIN_config/pages.json
PAGE_ELEMENTS_PATH=/config/HIB_ADMIN_config/mappings/
USERS_CONFIG_PATH=/config/HIB_ADMIN_config/users.json
LOGIN_URL=https://peracto.hib.co.uk/login
GUEST_URL=https://peracto.hib.co.uk
LOGIN_SUCCESS_URL=https://peracto.hib.co.uk/

FEATURE_PATH=./src/features/CARBON_ADMIN_SHARED_features/**/*.feature
