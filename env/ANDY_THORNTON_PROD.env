UI_AUTOMATION_BROWSER='chromium'
UI_AUTOMATION_HOST=production
SCREENSHOT_PATH=./reports/screenshots/
VIDEO_PATH=./reports/videos/
JSON_REPORT_FILE=./reports/ANDY_THORNTON_PROD/report.json
HTML_REPORT_FILE=./reports/cucumber-html-report.html
HEADLESS=true
SCRIPT_TIMEOUT=20000
PARALLEL=1
RETRY=1
PROJECT=andy_thornton_prod
HOSTS_URL_PATH=/config/ANDY_THORNTON_config/hosts.json
PAGES_URL_PATH=/config/ANDY_THORNTON_config/pages.json
PAGE_ELEMENTS_PATH=/config/ANDY_THORNTON_config/mappings/
USERS_CONFIG_PATH=/config/ANDY_THORNTON_config/users.json
LOGIN_URL=https://www.andythornton.com/login
GUEST_URL=https://www.andythornton.com
LOGIN_SUCCESS_URL=https://www.andythornton.com/account

FEATURE_PATH=./src/features/ANDY_THORNTON_features/**/*.feature

# Cookiebot banner blocks clicks on production (not on staging) - blocked for the whole run, same as INDESPENSION_PROD.env
BLOCK_REQUEST_HOSTS=cookiebot.com cookiebot.eu
