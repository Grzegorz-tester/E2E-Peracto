UI_AUTOMATION_BROWSER='chromium'
UI_AUTOMATION_HOST=production
SCREENSHOT_PATH=./reports/screenshots/
VIDEO_PATH=./reports/videos/
JSON_REPORT_FILE=./reports/Insinkerator_PROD/report.json
HTML_REPORT_FILE=./reports/cucumber-html-report.html
HEADLESS=true
SCRIPT_TIMEOUT=20000
PARALLEL=1
RETRY=1
PROJECT=insinkerator_prod
EXCLUDE_TAGS=@blocked-by-production-waf
HOSTS_URL_PATH=/config/Insinkerator_config/hosts.json
PAGES_URL_PATH=/config/Insinkerator_config/pages.json
PAGE_ELEMENTS_PATH=/config/Insinkerator_config/mappings/
USERS_CONFIG_PATH=/config/Insinkerator_config/users.json
LOGIN_URL=https://www.insinkerator.co.uk/login
GUEST_URL=https://www.insinkerator.co.uk
LOGIN_SUCCESS_URL=https://www.insinkerator.co.uk/account

FEATURE_PATH=./src/features/Insinkerator_features/**/*.feature
