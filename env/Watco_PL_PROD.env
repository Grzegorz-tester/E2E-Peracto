# LIVE/PRODUCTION - read the "Staging vs production rules" section of
# CLAUDE.md before running anything against this file. Never place a real
# order on production: the @places-real-order tag on the one Watco
# scenario that completes an order (logged-in-checkout-vat-persistence) is
# auto-excluded from every profile below whenever UI_AUTOMATION_HOST is
# exactly "production" (see productionExclusion in src/index.ts) - this
# only works because that scenario is correctly tagged; if you add a new
# scenario that completes a real order, tag it @places-real-order too.
UI_AUTOMATION_BROWSER='chromium'
UI_AUTOMATION_HOST=production
SCREENSHOT_PATH=./reports/screenshots/
VIDEO_PATH=./reports/videos/
JSON_REPORT_FILE=./reports/report.json
HTML_REPORT_FILE=./reports/cucumber-html-report.html
HEADLESS=true
SCRIPT_TIMEOUT=20000
PARALLEL=1
RETRY=1
PROJECT=watco_pl_prod
HOSTS_URL_PATH=/config/Watco_PL_config/hosts.json
PAGES_URL_PATH=/config/Watco_PL_config/pages.json
PAGE_ELEMENTS_PATH=/config/Watco_PL_config/mappings/
USERS_CONFIG_PATH=/config/Watco_PL_config/users.json
GUEST_URL=https://www.watco.pl

FEATURE_PATH=./src/features/Watco_PL_features/**/*.feature
