UI_AUTOMATION_BROWSER='chromium'
UI_AUTOMATION_HOST=production
SCREENSHOT_PATH=./reports/screenshots/
VIDEO_PATH=./reports/videos/
JSON_REPORT_FILE=./reports/HIB_PROD/report.json
HTML_REPORT_FILE=./reports/cucumber-html-report.html
HEADLESS=true
SCRIPT_TIMEOUT=35000
PARALLEL=1
RETRY=1
PROJECT=hib_prod
HOSTS_URL_PATH=/config/HIB_config/hosts.json
PAGES_URL_PATH=/config/HIB_config/pages.json
PAGE_ELEMENTS_PATH=/config/HIB_config/mappings/
USERS_CONFIG_PATH=/config/HIB_config/users.json
LOGIN_URL=https://www.hib.co.uk/login
GUEST_URL=https://www.hib.co.uk
LOGIN_SUCCESS_URL=https://www.hib.co.uk/

# Production-only CookieYes consent banner covers the bottom of the viewport
# and swallows forced clicks (e.g. PDP variant lozenges open its Customise
# modal instead) - confirmed live 2026-10-15. Blocking it removes the banner
# with no page errors.
BLOCK_REQUEST_HOSTS=cookieyes.com

FEATURE_PATH=./src/features/HIB_features/**/*.feature
